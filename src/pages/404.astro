---
// GitHub Pages serves one 404 page for every language, so it speaks both.
import Base from "../layouts/Base.astro";
import { localePath } from "../lib/i18n";

const base = import.meta.env.BASE_URL;
---

<Base lang="en" title="Page not found">
  <div class="wrap notfound">
    <p class="label">404</p>
    <h1>Page not found</h1>
    <p>This page doesn't exist, or doesn't exist yet.</p>
    <p>
      <a class="btn primary" href={localePath(base, "en")}>
        Go to the home page
      </a>
    </p>
    <div lang="mn">
      <h2>Хуудас олдсонгүй</h2>
      <p>Энэ хуудас байхгүй, эсвэл одоогоор бүтээгдээгүй байна.</p>
      <p>
        <a class="btn" href={localePath(base, "mn")}>
          Нүүр хуудас руу очих
        </a>
      </p>
    </div>
  </div>
</Base>

<style>
  .notfound {
    padding-top: 56px;
    padding-bottom: 56px;
  }
  .notfound h2 {
    margin-top: 40px;
  }
</style>
