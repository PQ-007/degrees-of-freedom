---
// Robots: kinds of robots taken apart, as a row of picture cards like
// Hardware. (The Builds that shared this page were removed by the user on
// 2026-11-16.) More arrive as they are written (CONTENT_PLAN.md §5).
import Base from "../../../layouts/Base.astro";
import Carousel from "../../../components/Carousel.astro";
import { getRobots } from "../../../lib/atlas";
import { languages, t, type Lang } from "../../../lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const robots = await getRobots(lang);
// On a card the teardown drawing shows without its numbered callouts.
const bare = (svg: string) =>
  svg.replace(/<g class="callouts">[\s\S]*<\/g>\s*(?=<\/svg>)/, "");
---

<Base lang={lang} title={t(lang, "robots.title")}>
  <div class="wrap page">
    <h1>{t(lang, "robots.title")}</h1>
    <p class="lead">{t(lang, "robots.lead")}</p>
    <Carousel
      id="teardowns"
      lang={lang}
      heading={t(lang, "robots.how")}
      items={robots.map((r) => ({
        url: r.url,
        title: `${r.data.id} · ${r.title}`,
        summary: r.summary,
        svg: bare(r.svg),
      }))}
    />
  </div>
</Base>

<style>
  .page {
    padding-top: 40px;
    padding-bottom: 64px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .lead {
    font-size: 1.1rem;
    margin: 0 0 28px;
    max-width: 46rem;
  }
  /* A teardown drawing is drawn large (800 wide); on a card its lines keep
     their screen width instead of shrinking with it. */
  .page :global(#teardowns .art svg *) {
    vector-effect: non-scaling-stroke;
    stroke-width: 1.6;
  }
  .page :global(#teardowns .art svg .thin) {
    stroke-width: 1.1;
  }
  .page :global(#teardowns .art svg .thick) {
    stroke-width: 2.5;
  }
</style>
