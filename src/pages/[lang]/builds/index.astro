---
// The Builds moved onto the Robots page (the user, 2026-11-15: "combine
// robots and builds tab"). This address stays so old links still work: it
// forwards to the Builds row, and says where they went for anyone without
// JavaScript.
import Base from "../../../layouts/Base.astro";
import { languages, localePath, t, type Lang } from "../../../lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const target = localePath(import.meta.env.BASE_URL, lang, "robots/#builds");
---

<Base lang={lang} title={t(lang, "builds.title")}>
  <div class="wrap page" data-forward={target}>
    <h1>{t(lang, "builds.title")}</h1>
    <p>
      {t(lang, "builds.moved")}
      <a href={target}>{t(lang, "builds.movedLink")} →</a>
    </p>
  </div>
</Base>

<script>
  const to =
    document.querySelector<HTMLElement>("[data-forward]")?.dataset["forward"];
  if (to) location.replace(to);
</script>

<style>
  .page {
    padding-top: 40px;
    padding-bottom: 64px;
  }
</style>
