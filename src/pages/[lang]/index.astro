---
import Base from "../../layouts/Base.astro";
import Carousel from "../../components/Carousel.astro";
import cartpole from "../../../content/figures/sim-cartpole.svg?raw";
import { languages, localePath, t, type Lang } from "../../lib/i18n";
import { tiers } from "../../lib/tiers";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL;
// The simulations (the user, 2026-11-15: a card on the home page, so the
// MuJoCo demo isn't buried in tier 3). One card per sim demo, as a row that
// grows like Hardware's.
const sims = [
  {
    url: localePath(base, lang, "node/classical-control/#try"),
    title: t(lang, "home.sims.cartpole"),
    summary: t(lang, "home.sims.cartpoleLine"),
    svg: cartpole,
  },
];
---

<Base lang={lang}>
  <div class="hero-band grid-bg">
    <div class="wrap hero">
      <div>
        <p class="label">{t(lang, "home.eyebrow")}</p>
        <h1>{t(lang, "site.name")}</h1>
        <p class="lead">{t(lang, "home.lead")}</p>
        <p class="callout status">{t(lang, "home.status")}</p>
        <p class="actions">
          <a
            class="btn primary"
            href={localePath(import.meta.env.BASE_URL, lang, "tree/")}
          >
            {t(lang, "home.cta")}
          </a>
        </p>
      </div>
      <ol class="tiers" aria-label={t(lang, "tiers.label")}>
        {tiers.map((tier) => (
          <li class={tier.className}>
            <span class="id">
              <span class="sq" aria-hidden="true" />
              {tier.id}
            </span>
            <span>{t(lang, tier.nameKey)}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <div class="wrap sims">
    <Carousel
      id="simulations"
      lang={lang}
      heading={t(lang, "home.sims.title")}
      summary={t(lang, "home.sims.lead")}
      tone="t3"
      items={sims}
    />
  </div>
</Base>

<style>
  .sims {
    padding-top: 40px;
    padding-bottom: 24px;
  }
  .hero-band {
    border-bottom: 2px solid var(--line);
  }
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 56px;
  }
  .label {
    margin: 0 0 12px;
  }
  .lead {
    font-size: 1.2rem;
    max-width: 34ch;
    margin: 0 0 26px;
  }
  .actions {
    margin: 22px 0 0;
  }
  .status {
    margin: 0;
    font-size: 15px;
    max-width: 44ch;
  }
  /* T0 first, at the top: begin with the foundations (the user, 2026-11-14). */
  .tiers {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 2px solid var(--line);
    background: var(--surface);
    display: flex;
    flex-direction: column;
  }
  .tiers li {
    display: grid;
    grid-template-columns: 64px 1fr;
    align-items: center;
    padding: 10px 14px;
    border-top: 2px solid var(--line);
  }
  .tiers li:first-child {
    border-top: 0;
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-top: 40px;
      padding-bottom: 40px;
    }
  }
</style>
