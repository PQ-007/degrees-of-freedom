---
// The tech tree as a course: a step rail with the seven tiers (T0 first), and
// the chosen tier's topics as cards. Each card says what its topic needs and
// what it unlocks; those are links that jump to that topic, in any tier.
// Without JS every tier shows, one after another, and the links are anchors.
import Base from "../../layouts/Base.astro";
import { getAtlas, type AtlasNode } from "../../lib/atlas";
import { format, languages, t, type Lang } from "../../lib/i18n";
import { tiers } from "../../lib/tiers";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const atlas = await getAtlas(lang);
const byId = new Map(atlas.map((n) => [n.id, n]));
const steps = tiers.map((tier, n) => ({
  ...tier,
  name: t(lang, tier.nameKey),
  nodes: atlas.filter((node) => node.tier === n),
}));
const refs = (ids: string[]) =>
  ids.map((id) => byId.get(id)).filter((n): n is AtlasNode => n !== undefined);
---

<Base lang={lang} title={t(lang, "tree.title")}>
  <div class="wrap wide">
    <header class="page-head">
      <h1>{t(lang, "tree.title")}</h1>
      <p class="lead">{t(lang, "tree.lead")}</p>
      <p class="label">{format(t(lang, "tree.count"), { n: atlas.length })}</p>
    </header>

    <div class="tree-layout" data-tree>
      <nav class="rail" aria-label={t(lang, "tree.tiers")}>
        <ol>
          {steps.map((step) => (
            <li class={step.className}>
              <a href={`#${step.id}`} data-step={step.id}>
                <span class="sq" aria-hidden="true" />
                <span class="step-text">
                  <span class="step-id">{step.id}</span>
                  <span class="step-name">{step.name}</span>
                </span>
                <span class="step-count">{step.nodes.length}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="tiers">
        {steps.map((step, i) => {
          const prev = steps[i - 1];
          const next = steps[i + 1];
          return (
            <section
              class={`tier ${step.className}`}
              id={step.id}
              data-tier={step.id}
            >
              <h2 tabindex="-1">
                <span class="id">
                  <span class="sq" aria-hidden="true" />
                  {step.id}
                </span>
                {step.name}
                <span class="label">
                  {format(t(lang, "tree.tierCount"), { n: step.nodes.length })}
                </span>
              </h2>
              <ul class="cards">
                {step.nodes.map((node) => (
                  <li class={`card bar t${node.tier}`} id={node.id}>
                    <span class="id">
                      <span class="sq" aria-hidden="true" />
                      {step.id} · {node.id}
                    </span>
                    <h3>
                      <a href={node.url}>{node.title}</a>
                    </h3>
                    <p class="summary">{node.summary}</p>
                    <dl class="links">
                      <dt>{t(lang, "node.needs")}</dt>
                      <dd>
                        {node.needs.length === 0 ? (
                          <span class="muted">{t(lang, "node.start")}</span>
                        ) : (
                          refs(node.needs).map((n) => (
                            <a
                              class={`chip t${n.tier}`}
                              href={`#${n.id}`}
                              data-jump={n.id}
                            >
                              <span class="sq" aria-hidden="true" />
                              {n.id} {n.title}
                            </a>
                          ))
                        )}
                      </dd>
                      <dt>{t(lang, "tree.unlocks")}</dt>
                      <dd>
                        {node.usedBy.length === 0 ? (
                          <span class="muted">{t(lang, "node.leaf")}</span>
                        ) : (
                          refs(node.usedBy).map((n) => (
                            <a
                              class={`chip t${n.tier}`}
                              href={`#${n.id}`}
                              data-jump={n.id}
                            >
                              <span class="sq" aria-hidden="true" />
                              {n.id} {n.title}
                            </a>
                          ))
                        )}
                      </dd>
                    </dl>
                  </li>
                ))}
              </ul>
              <div class="pager">
                {prev ? (
                  <a class="btn small" href={`#${prev.id}`} data-step={prev.id}>
                    ← {prev.id} {prev.name}
                  </a>
                ) : (
                  <span />
                )}
                {next && (
                  <a
                    class="btn small primary"
                    href={`#${next.id}`}
                    data-step={next.id}
                  >
                    {next.id} {next.name} →
                  </a>
                )}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </div>
</Base>

<style>
  .wide {
    max-width: 1320px;
  }
  .page-head {
    padding: 40px 0 28px;
  }
  .page-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .lead {
    margin: 0 0 10px;
    font-size: 1.1rem;
  }
  .page-head .label {
    margin: 0;
  }

  .tree-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 32px;
    align-items: start;
    padding-bottom: 64px;
  }

  /* ---- The step rail: T0 first, a line joining the steps ---- */
  .rail {
    position: sticky;
    top: 76px;
  }
  .rail ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rail li {
    position: relative;
    padding-bottom: 10px;
  }
  .rail li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 20px;
    top: 0;
    bottom: 0;
    border-left: 2px solid var(--line);
  }
  .rail a {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border: 2px solid var(--line);
    background: var(--surface);
    text-decoration: none;
  }
  .rail a:hover {
    border-color: var(--ink);
    box-shadow: var(--shadow-sm);
    transform: translate(-2px, -2px);
  }
  .rail a[aria-current]:hover {
    box-shadow: var(--shadow-shade-sm);
  }
  .rail a[aria-current] {
    background: var(--primary-bg);
    color: var(--primary-fg);
    border-color: var(--primary-bg);
  }
  .step-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .step-id {
    font: 700 11.5px var(--mono);
    letter-spacing: 0.06em;
  }
  .step-name {
    font-size: 14.5px;
    font-weight: 600;
  }
  .step-count {
    font: 500 12px var(--mono);
    opacity: 0.75;
  }

  /* ---- A tier: its topics as cards ---- */
  .tier {
    border-top: 0;
    padding: 0 0 40px;
    scroll-margin-top: 84px;
  }
  /* With JS, only the chosen tier shows. */
  :global(.js) .tier:not(.current) {
    display: none;
  }
  .tier h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    font-size: 1.5rem;
    margin: 0 0 18px;
    outline-offset: 6px;
  }
  .tier h2 .label {
    font-weight: 500;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
    scroll-margin-top: 140px;
  }
  .card:hover,
  .card.flash {
    border-color: var(--ink);
    box-shadow: var(--shadow);
    transform: translate(-2px, -2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card.flash,
    .rail a:hover {
      transform: none;
    }
  }
  .card h3 {
    margin: 10px 0 6px;
    font-size: 1.12rem;
  }
  .card h3 a {
    text-decoration: none;
  }
  .card h3 a:hover {
    text-decoration: underline;
  }
  .summary {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 15px;
  }
  .links {
    margin: auto 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 13px;
  }
  .links dt {
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .links dd {
    margin: 0 0 8px;
  }
  .links dd:last-child {
    margin-bottom: 0;
  }
  .links .chip {
    font-size: 13px;
    padding: 4px 8px 4px 6px;
    line-height: 1.25;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  /* ---- Phones and small tablets: the rail becomes a strip of tier tabs ---- */
  @media (max-width: 860px) {
    .tree-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .rail {
      top: 62px;
      z-index: 4;
      background: var(--bg);
      padding: 8px 0;
      border-bottom: 2px solid var(--line);
    }
    .rail ol {
      display: flex;
      gap: 4px;
    }
    /* Seven equal tabs that always fit, down to 320px. */
    .rail li {
      padding: 0;
      flex: 1 1 0;
      min-width: 0;
    }
    .rail li::after {
      display: none;
    }
    .rail a {
      justify-content: center;
      gap: 5px;
      padding: 8px 0;
    }
    .rail .sq {
      width: 11px;
      height: 11px;
    }
    .tier {
      scroll-margin-top: 130px;
    }
    .step-name,
    .step-count {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .step-text {
      flex: none;
    }
    .card {
      scroll-margin-top: 130px;
    }
  }
</style>

<script>
  import { initTierSteps } from "../../lib/tree-view";

  const tree = document.querySelector<HTMLElement>("[data-tree]");
  if (tree) initTierSteps(tree);
</script>
