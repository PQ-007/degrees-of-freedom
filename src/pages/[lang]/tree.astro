---
import Base from "../../layouts/Base.astro";
import { getAtlas } from "../../lib/atlas";
import { format, languages, t, type Lang } from "../../lib/i18n";
import { tiers } from "../../lib/tiers";
import type { PanelNode } from "../../lib/tree-view";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const atlas = await getAtlas(lang);
const byTier = tiers.map((tier, n) => ({
  ...tier,
  name: t(lang, tier.nameKey),
  nodes: atlas.filter((node) => node.tier === n),
}));
const byId = new Map(atlas.map((n) => [n.id, n]));
const label = (id: string) => `${id} ${byId.get(id)?.title ?? ""}`;

// What the focus panel needs in the browser, as JSON in the page.
const panelData: PanelNode[] = atlas.map((n) => ({
  id: n.id,
  tier: n.tier,
  title: n.title,
  summary: n.summary,
  url: n.url,
  needs: n.needs,
  usedBy: n.usedBy,
}));
const tierNames = byTier.map((tier) => tier.name);
---

<Base lang={lang} title={t(lang, "tree.title")}>
  <div class="wrap wide">
    <header class="page-head">
      <div>
        <h1>{t(lang, "tree.title")}</h1>
        <p class="lead">{t(lang, "tree.lead")}</p>
        <p class="label">
          {format(t(lang, "tree.count"), { n: atlas.length })}
        </p>
      </div>
      <div class="views" role="group" aria-label={t(lang, "tree.view")}>
        <button
          class="btn small"
          type="button"
          data-view="graph"
          aria-pressed="false"
        >
          {t(lang, "tree.graph")}
        </button>
        <button
          class="btn small"
          type="button"
          data-view="list"
          aria-pressed="false"
        >
          {t(lang, "tree.list")}
        </button>
      </div>
    </header>

    <div class="tree-views" data-tree-views>
      <div class="graph-view">
        <section
          class="tree grid-bg"
          aria-label={t(lang, "tree.graphLabel")}
          data-tree
        >
          {[...byTier].reverse().map((tier) => (
            <div class={`band ${tier.className}`}>
              <div class="band-name">
                <span class="id">
                  <span class="sq" aria-hidden="true" />
                  {tier.id}
                </span>
                <span>{tier.name}</span>
              </div>
              <ul class="band-nodes">
                {tier.nodes.map((node) => (
                  <li>
                    <a
                      class={`node t${node.tier}`}
                      href={node.url}
                      data-id={node.id}
                    >
                      <span class="sq" aria-hidden="true" />
                      <span class="nid">{node.id}</span>
                      {node.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>

        <aside
          class="panel"
          aria-label={t(lang, "tree.panelLabel")}
          data-panel
          data-empty
          hidden
          data-strings={JSON.stringify({
            needs: t(lang, "node.needs"),
            unlocks: t(lang, "tree.unlocks"),
            start: t(lang, "node.start"),
            leaf: t(lang, "node.leaf"),
            path: t(lang, "tree.path"),
            pathCount: t(lang, "tree.pathCount"),
            open: t(lang, "tree.open"),
            close: t(lang, "tree.close"),
            selected: t(lang, "tree.selected"),
          })}
        >
          <p class="panel-hint">{t(lang, "tree.hint")}</p>
          <div class="panel-body" data-panel-body></div>
        </aside>
        <p class="visually-hidden" aria-live="polite" data-announce></p>
        <script
          type="application/json"
          id="tree-data"
          set:html={JSON.stringify({ nodes: panelData, tiers: tierNames })}
        />
      </div>

      <div class="list-view">
        {byTier.map((tier) => (
          <section class={`tier ${tier.className}`}>
            <h2>
              <span class="id">
                <span class="sq" aria-hidden="true" />
                {tier.id}
              </span>
              {tier.name}
            </h2>
            <ol class="node-list">
              {tier.nodes.map((node) => (
                <li>
                  <a class="node-link" href={node.url}>
                    <span class="nid">{node.id}</span>
                    {node.title}
                  </a>
                  <p class="summary">{node.summary}</p>
                  <p class="needs">
                    <span class="muted">{t(lang, "node.needs")}:</span>{" "}
                    {node.needs.length === 0
                      ? t(lang, "node.start")
                      : node.needs.map((id, i) => (
                          <>
                            {i > 0 && ", "}
                            <a href={byId.get(id)?.url}>{label(id)}</a>
                          </>
                        ))}
                  </p>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </div>
</Base>

<style>
  .wide {
    max-width: 1440px;
  }
  .page-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 32px;
    flex-wrap: wrap;
    padding: 40px 0 24px;
  }
  .page-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .lead {
    margin: 0 0 10px;
    font-size: 1.1rem;
  }
  .page-head .label {
    margin: 0;
  }
  .views {
    display: flex;
    gap: 10px;
  }
  .views [aria-pressed="true"] {
    background: var(--primary-bg);
    color: var(--primary-fg);
    border-color: var(--primary-bg);
  }

  /* Which view shows: the graph on wide screens, the list on phones; a choice
     made with the buttons (data-view on the container) overrides both. */
  .list-view {
    display: none;
  }
  @media (max-width: 640px) {
    .tree-views:not([data-view]) .graph-view {
      display: none;
    }
    .tree-views:not([data-view]) .list-view {
      display: block;
    }
  }
  .tree-views[data-view="list"] .graph-view {
    display: none;
  }
  .tree-views[data-view="list"] .list-view {
    display: block;
  }
  .tree-views[data-view="graph"] .graph-view {
    display: grid;
  }
  .tree-views[data-view="graph"] .list-view {
    display: none;
  }

  /* ---- Graph: tier bands (T0 at the bottom) beside the focus panel ---- */
  .graph-view {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 24px;
    align-items: start;
    padding-bottom: 48px;
  }
  .tree {
    border: 2px solid var(--line);
    padding: 0;
  }
  .band {
    display: grid;
    grid-template-columns: 180px 1fr;
    border-top: 2px solid var(--line);
  }
  .band:first-child {
    border-top: 0;
  }
  .band-name {
    padding: 14px;
    border-right: 2px solid var(--line);
    background: var(--bg);
  }
  .band-name .id {
    margin-bottom: 6px;
  }
  .band-name span:last-child {
    display: block;
    font-size: 14px;
    font-weight: 600;
  }
  .band-nodes {
    list-style: none;
    margin: 0;
    padding: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-content: flex-start;
  }

  /* Node chips. Selected: filled. What it needs: solid ink border.
     What it unlocks: dashed ink border. Nothing else changes. */
  .tree :global(.node) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px 6px 8px;
    background: var(--surface);
    border: 2px solid var(--line);
    font-size: 14px;
    line-height: 1.2;
    text-decoration: none;
  }
  .tree :global(.node:hover) {
    border-color: var(--ink);
  }
  .tree :global(.node.on) {
    background: var(--primary-bg);
    color: var(--primary-fg);
    border-color: var(--primary-bg);
  }
  .tree :global(.node.on .nid) {
    color: inherit;
  }
  .tree :global(.node.need),
  .tree :global(.node.unlock) {
    border-color: var(--ink);
    font-weight: 600;
  }
  .tree :global(.node.unlock) {
    border-style: dashed;
  }
  .nid,
  :global(.panel .nid) {
    font: 700 11.5px var(--mono);
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  /* ---- The focus panel ---- */
  .panel {
    position: sticky;
    top: 76px;
    max-height: calc(100vh - 92px);
    overflow-y: auto;
    border: 2px solid var(--line);
    background: var(--surface);
    padding: 16px 18px 18px;
    font-size: 15px;
  }
  .panel[hidden] {
    display: none;
  }
  .panel-hint {
    margin: 0;
    color: var(--muted);
  }
  .panel:not([data-empty]) .panel-hint {
    display: none;
  }
  .panel :global(.panel-head) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .panel :global(h2) {
    font-size: 1.35rem;
    margin: 10px 0 6px;
  }
  .panel :global(.panel-summary) {
    margin: 0 0 16px;
  }
  .panel :global(.close) {
    font: 600 14px/1 var(--font);
    background: none;
    color: var(--ink);
    border: 2px solid var(--line);
    padding: 6px 9px;
    cursor: pointer;
  }
  .panel :global(.close:hover) {
    border-color: var(--ink);
  }
  .panel :global(.flow) {
    border-top: 1px solid var(--rule);
    padding: 12px 0;
  }
  .panel :global(.flow-label) {
    display: block;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .panel :global(.flow ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .panel :global(.pick) {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    text-align: left;
    font: 500 14px/1.25 var(--font);
    color: var(--ink);
    background: var(--surface);
    border: 2px solid var(--line);
    padding: 6px 10px 6px 8px;
    cursor: pointer;
  }
  .panel :global(.pick:hover) {
    border-color: var(--ink);
  }
  .panel :global(.unlocks .pick) {
    border-style: dashed;
  }
  .panel :global(.pick .sq) {
    width: 10px;
    height: 10px;
    border-width: 1.5px;
  }
  .panel :global(.this) {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    padding: 4px 0;
  }
  .panel :global(.arrow) {
    display: block;
    text-align: center;
    color: var(--muted);
    line-height: 1;
    margin: 2px 0;
  }
  .panel :global(details) {
    border-top: 1px solid var(--rule);
    padding: 12px 0 4px;
  }
  .panel :global(summary) {
    cursor: pointer;
    font-weight: 600;
  }
  .panel :global(.path-tier) {
    margin: 10px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
  }
  .panel :global(.path-tier .id) {
    margin-right: 6px;
  }
  .panel :global(.path-tier button) {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .panel :global(.open) {
    margin-top: 14px;
  }

  /* Narrower screens: the tree takes the width and the panel becomes a
     bottom sheet, shown only once a topic is selected. */
  @media (max-width: 1100px) {
    .graph-view,
    .tree-views[data-view="graph"] .graph-view {
      grid-template-columns: minmax(0, 1fr);
    }
    .panel {
      position: fixed;
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 20;
      max-height: 55vh;
      border-width: 2px 0 0;
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.18);
    }
    .panel[data-empty] {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .band {
      grid-template-columns: minmax(0, 1fr);
    }
    .band-name {
      border-right: 0;
      border-bottom: 2px solid var(--line);
      display: flex;
      gap: 12px;
      align-items: center;
      padding: 10px 14px;
    }
    .band-name .id {
      margin: 0;
    }
  }

  /* ---- List: the accessible equivalent, and the phone default ---- */
  .list-view {
    padding-bottom: 48px;
  }
  .tier {
    border-top: 2px solid var(--line);
    padding: 28px 0 8px;
  }
  .tier h2 {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 1.3rem;
  }
  .node-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 4px 32px;
  }
  .node-list li {
    padding: 10px 0 12px;
    border-top: 1px solid var(--rule);
  }
  .node-link {
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    gap: 8px;
    align-items: baseline;
  }
  .node-link:hover {
    text-decoration: underline;
  }
  .summary {
    margin: 4px 0;
    font-size: 15px;
  }
  .needs {
    margin: 0;
    font-size: 13.5px;
  }
</style>

<script>
  import { format } from "../../lib/i18n";
  import { initTreePanel, initViewSwitch } from "../../lib/tree-view";

  const views = document.querySelector<HTMLElement>("[data-tree-views]");
  if (views)
    initViewSwitch(
      views,
      document.querySelectorAll<HTMLButtonElement>("[data-view]"),
    );
  const tree = document.querySelector<HTMLElement>("[data-tree]");
  const panel = document.querySelector<HTMLElement>("[data-panel]");
  const announce = document.querySelector<HTMLElement>("[data-announce]");
  const data = document.getElementById("tree-data")?.textContent;
  if (tree && panel && announce && data)
    initTreePanel(tree, panel, announce, JSON.parse(data), format);
</script>
