---
// A Hardware category (the user, 2026-11-14: category pages with an entry per
// type): the intro, a jump list of the types, then each type's entry (facts,
// how it works, common models in a dated box); the compare table folded at
// the end as a side feature; sources.
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import CompareTable from "../../../components/CompareTable.astro";
import SourceList from "../../../components/SourceList.astro";
import { getAtlas, getHardware } from "../../../lib/atlas";
import { languages, localePath, t, type Lang } from "../../../lib/i18n";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of languages) {
    for (const page of await getHardware(lang)) {
      paths.push({
        params: { lang, slug: page.data.slug },
        props: { id: page.data.id },
      });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { id } = Astro.props;
const page = (await getHardware(lang)).find((p) => p.data.id === id);
if (!page) throw new Error(`no Hardware page ${id}`);
const atlas = await getAtlas(lang);
const topics = page.data.nodes
  .map((n) => atlas.find((a) => a.id === n))
  .filter((n) => n !== undefined);
const { Content, remarkPluginFrontmatter } = await render(page.entry);
const citedIds =
  (remarkPluginFrontmatter["citations"] as string[] | undefined) ?? [];
const base = import.meta.env.BASE_URL;
const rowLinks = Object.fromEntries(
  page.data.types.map((ty) => [ty.key, `#${ty.key}`]),
);
---

<Base lang={lang} title={page.title} description={page.summary}>
  <div class="wrap page">
    <article data-pagefind-body data-pagefind-meta={`id:${page.data.id}`}>
      <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
        <a href={localePath(base, lang, "hardware/")}>
          {t(lang, "hardware.title")}
        </a>
        <span aria-hidden="true">›</span>
        <span class="id">{page.data.id}</span>
      </nav>
      <h1>{page.title}</h1>
      <p class="summary">{page.summary}</p>

      <dl class="meta" data-pagefind-ignore>
        {topics.length > 0 && (
          <>
            <dt>{t(lang, "compare.topics")}</dt>
            <dd>
              {topics.map((n) => (
                <a class={`chip t${n.tier}`} href={n.url}>
                  <span class="sq" aria-hidden="true" />
                  {n.id} {n.title}
                </a>
              ))}
            </dd>
          </>
        )}
        <dt>{t(lang, "hardware.types")}</dt>
        <dd>
          <ul class="jump">
            {page.data.types.map((ty) => (
              <li>
                <a href={`#${ty.key}`}>{ty.name[lang]}</a>
              </li>
            ))}
            {page.table && (
              <li>
                <a href="#compare">{t(lang, "hardware.compare")}</a>
              </li>
            )}
          </ul>
        </dd>
      </dl>

      <div class="prose hardware">
        <Content />
      </div>

      {page.table && (
        <details class="compare-fold" id="compare" data-pagefind-ignore>
          <summary>{t(lang, "hardware.compare")}</summary>
          <p class="muted">{t(lang, "hardware.compareLead")}</p>
          <CompareTable
            table={page.table}
            lang={lang}
            label={`${t(lang, "hardware.compare")}: ${page.title}`}
            rowLinks={rowLinks}
          />
        </details>
      )}

      <SourceList lang={lang} ids={citedIds} />
    </article>
  </div>
</Base>

<style>
  .page {
    padding-top: 40px;
    padding-bottom: 64px;
  }
  article > .prose,
  article > .crumbs,
  article > h1,
  article > .summary,
  article > .meta {
    max-width: 46rem;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 14px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.6rem);
    letter-spacing: -0.035em;
    margin: 16px 0 12px;
  }
  .summary {
    font-size: 1.15rem;
    margin: 0 0 20px;
  }
  .meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 16px;
    align-items: baseline;
    margin: 0 0 8px;
    font-size: 14px;
  }
  .meta dt {
    color: var(--muted);
    font-weight: 500;
  }
  .meta dd {
    margin: 0;
  }
  .jump {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  /* Each type's facts: the list right under its heading, as a small card. */
  .hardware :global(h2) {
    border-top: 2px solid var(--line);
    padding-top: 22px;
  }
  .hardware :global(h2 + ul) {
    list-style: none;
    margin: 0 0 16px;
    padding: 10px 14px;
    border: 2px solid var(--line);
    background: var(--surface);
    max-width: 46rem;
    font-size: 15px;
  }
  .hardware :global(h2 + ul li) {
    margin: 4px 0;
  }

  .compare-fold {
    margin: 36px 0 8px;
    border: 2px solid var(--line);
    background: var(--bg);
  }
  .compare-fold > summary {
    cursor: pointer;
    padding: 12px 16px;
    font-weight: 700;
    font-size: 1.1rem;
  }
  .compare-fold[open] > summary {
    border-bottom: 2px solid var(--line);
  }
  .compare-fold > :not(summary) {
    margin-left: 16px;
    margin-right: 16px;
  }
  .compare-fold > :last-child {
    margin-bottom: 16px;
  }
  .compare-fold > p {
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .meta {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .compare-fold > :not(summary) {
      margin-left: 10px;
      margin-right: 10px;
    }
  }
</style>
