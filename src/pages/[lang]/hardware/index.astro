---
// Hardware (the user, 2026-11-14): like a streaming catalogue, one row of
// picture cards per category (motors, then microcontrollers, then sensors…);
// each card opens that kind of part's page.
import Base from "../../../layouts/Base.astro";
import Carousel from "../../../components/Carousel.astro";
import { getHardware } from "../../../lib/atlas";
import { languages, t, type Lang } from "../../../lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const categories = await getHardware(lang);
---

<Base lang={lang} title={t(lang, "hardware.title")}>
  <div class="wrap page t1">
    <h1>{t(lang, "hardware.title")}</h1>
    <p class="lead">{t(lang, "hardware.lead")}</p>
    {categories.map((c) => (
      <Carousel
        id={c.data.slug}
        lang={lang}
        heading={c.title}
        summary={c.summary}
        items={c.types.map((ty) => ({
          url: ty.url,
          title: ty.title,
          summary: ty.summary,
          svg: ty.svg,
        }))}
      />
    ))}
    <p class="next muted">{t(lang, "hardware.next")}</p>
  </div>
</Base>

<style>
  .page {
    padding-top: 40px;
    padding-bottom: 64px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .lead {
    font-size: 1.1rem;
    margin: 0 0 32px;
    max-width: 46rem;
  }
  .next {
    margin: 8px 0 0;
    font-size: 14px;
  }
</style>
