---
// Hardware (the user, 2026-11-14: in place of the Compare tab): an
// encyclopedia of the parts robots are built from, one page per category.
import Base from "../../../layouts/Base.astro";
import { getHardware } from "../../../lib/atlas";
import { languages, t, type Lang } from "../../../lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const categories = await getHardware(lang);
---

<Base lang={lang} title={t(lang, "hardware.title")}>
  <div class="wrap page">
    <h1>{t(lang, "hardware.title")}</h1>
    <p class="lead">{t(lang, "hardware.lead")}</p>
    <ul class="list">
      {categories.map((c) => (
        <li>
          <a class="card" href={c.url}>
            <span class="id">{c.data.id}</span>
            <h2>{c.title}</h2>
            <p>{c.summary}</p>
            <p class="types">
              {c.data.types.map((ty) => ty.name[lang]).join(" · ")}
            </p>
          </a>
        </li>
      ))}
    </ul>
    <p class="next muted">{t(lang, "hardware.next")}</p>
  </div>
</Base>

<style>
  .page {
    padding-top: 40px;
    padding-bottom: 64px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .lead {
    font-size: 1.1rem;
    margin: 0 0 28px;
    max-width: 46rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }
  .card h2 {
    font-size: 1.25rem;
    margin: 10px 0 6px;
  }
  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .card .types {
    margin-top: 12px;
    font-size: 13.5px;
    color: var(--ink);
  }
  .next {
    margin: 24px 0 0;
    font-size: 14px;
  }
</style>
