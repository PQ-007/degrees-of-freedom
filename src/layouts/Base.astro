---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/look.css";
import "katex/dist/katex.min.css";
import "../styles/prose.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import {
  languages,
  localePath,
  otherLang,
  switchLang,
  t,
  type Lang,
} from "../lib/i18n";

interface Props {
  lang: Lang;
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
}

const { lang, title, description = t(lang, "site.description") } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteName = t(lang, "site.name");
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const other = otherLang(lang);
const pathname = Astro.url.pathname;
// Robots holds both the teardowns and the Builds (the user, 2026-11-15:
// "combine robots and builds tab"), so it is the current tab on either.
const nav = [
  { href: localePath(base, lang, "tree/"), label: t(lang, "nav.tree") },
  { href: localePath(base, lang, "hardware/"), label: t(lang, "nav.hardware") },
  {
    href: localePath(base, lang, "robots/"),
    label: t(lang, "nav.robots"),
    also: localePath(base, lang, "builds/"),
  },
  { href: localePath(base, lang, "search/"), label: t(lang, "nav.search") },
];
const current = (item: { href: string; also?: string }) =>
  pathname.startsWith(item.href) ||
  (item.also !== undefined && pathname.startsWith(item.also));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {languages.map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(switchLang(base, pathname, l), Astro.site)}
      />
    ))}
    <script is:inline>
      document.documentElement.classList.add("js");
      // Before first paint: stored choice, else the system preference.
      try {
        const stored = localStorage.getItem("dof-theme");
        document.documentElement.dataset.theme =
          stored === "dark" || stored === "light"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
      } catch {
        document.documentElement.dataset.theme = matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches
          ? "dark"
          : "light";
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      {t(lang, "site.skip")}
    </a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={localePath(base, lang)}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">{siteName}</span>
        </a>
        <div class="header-panel" id="header-panel">
          <nav class="site-nav" aria-label={t(lang, "nav.label")}>
            {nav.map((item) => (
              <a
                href={item.href}
                aria-current={current(item) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
          <a
            class="btn small lang-switch lang-in-menu"
            href={switchLang(base, pathname, other)}
            hreflang={other}
            lang={other}
            title={t(lang, "lang.otherLabel")}
          >
            {t(lang, "lang.other")}
          </a>
        </div>
        <div class="header-tools">
          <a
            class="btn small lang-switch lang-in-tools"
            href={switchLang(base, pathname, other)}
            hreflang={other}
            lang={other}
            title={t(lang, "lang.otherLabel")}
          >
            {t(lang, "lang.other")}
          </a>
          <ThemeToggle lang={lang} />
          <button
            class="btn small menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="header-panel"
          >
            {t(lang, "nav.menu")}
          </button>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <a href={localePath(base, lang, "glossary/")}>
          {t(lang, "footer.glossary")}
        </a>
        <span aria-hidden="true"> · </span>
        <span>{t(lang, "footer.license")}</span>
        <span aria-hidden="true"> · </span>
        <a href="https://github.com/PQ-007/degrees-of-freedom">
          {t(lang, "footer.source")}
        </a>
      </div>
    </footer>
    <script>
      // Demos written into the Markdown (<cartpole-demo>…) load as they near
      // the screen; pages without one load nothing.
      import { upgradeDemos } from "../demos/registry";
      upgradeDemos();
    </script>
    <script>
      // Phones: the nav and the language link fold into a menu.
      const header = document.querySelector<HTMLElement>(".site-header");
      const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        header?.classList.toggle("menu-open", open);
      });
      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          toggle?.getAttribute("aria-expanded") === "true"
        ) {
          toggle.click();
          toggle.focus();
        }
      });
    </script>
  </body>
</html>
